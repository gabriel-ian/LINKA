# Copie este arquivo para .env e preencha com os valores locais.
# O .env NAO vai para o git (ja esta no .gitignore).

# Banco de dados
DB_HOST=localhost
DB_PORT=3306
DB_USER=root
DB_PASSWORD=troque-aqui
DB_NAME=bancolinka
DB_LOGGING=true

# JWT — gere um valor longo e aleatorio para producao
JWT_SECRET=troque-por-um-segredo-longo-e-aleatorio
JWT_EXPIRES_IN=1d

# CORS — origem do frontend Angular
FRONTEND_URL=http://localhost:4200

# Porta da API
PORT=3000

# IA — adapta tarefas, simplifica comunicados e ajuda o aluno.
# Opcional: sem nenhuma IA, o professor adapta as tarefas manualmente.
#
# Opcao 1: Claude (Anthropic). Se preenchida, tem prioridade.
ANTHROPIC_API_KEY=
#
# Opcao 2: qualquer servico no formato da OpenAI (alguns com plano gratuito).
# Exemplos:
#   Groq (gratis):  IA_URL=https://api.groq.com/openai/v1   IA_MODELO=openai/gpt-oss-120b
#                   (veja os modelos da sua conta em console.groq.com > Models; os nomes mudam)
#   Gemini:         IA_URL=https://generativelanguage.googleapis.com/v1beta/openai   IA_MODELO=gemini-2.5-flash
#                   (atencao: no plano gratis o Google usa os dados para melhorar
#                   os produtos dele; nao use com dados reais de alunos)
#   Ollama (local): IA_URL=http://localhost:11434/v1   IA_MODELO=llama3.1   (sem IA_CHAVE)
IA_URL=
IA_MODELO=
IA_CHAVE=

# E-mail (SMTP) — senha de acesso, "Esqueci minha senha" e resumo semanal
# das familias (domingo 18h). Opcional: sem SMTP_HOST nada e enviado e o
# conteudo dos e-mails aparece no terminal do backend.
# Ex.: Gmail (smtp.gmail.com, 587, senha de app), Brevo, SendGrid, Amazon SES.
SMTP_HOST=
SMTP_PORT=587
SMTP_USER=
SMTP_PASS=
MAIL_FROM=Linka <nao-responda@seudominio.com>
