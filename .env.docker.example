# Copie para .env.docker e preencha. Usado so pelo docker-compose.yml.
DB_ROOT_PASSWORD=troque-esta-senha-root
DB_PASSWORD=troque-esta-senha
JWT_SECRET=gere-um-valor-longo-e-aleatorio
JWT_EXPIRES_IN=1d

# Endereco publico do site (vai nos links dos e-mails) e porta local.
SITE_URL=http://localhost:8080
SITE_PORTA=8080

# Opcionais (ver backend/.env.example)
ANTHROPIC_API_KEY=
# ou uma IA no formato da OpenAI (ver backend/.env.example)
IA_URL=
IA_MODELO=
IA_CHAVE=
SMTP_HOST=
SMTP_PORT=587
SMTP_USER=
SMTP_PASS=
MAIL_FROM=Linka <nao-responda@seudominio.com>
